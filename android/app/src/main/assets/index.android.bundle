tEditor:{title:"Haltes",addStop:"Halte Toevoegen",limitReached:"Haltelimiet bereikt",stopName:"Haltenaam",stopAddress:"Halteadres",plannedArrival:"Geplande Aankomst",invalidCoords:"Ongeldige co\xf6rdinaten",noStops:"Nog geen haltes toegevoegd",coordinates:"Co\xf6rdinaten",removeStopConfirm:"Weet u zeker dat u deze halte wilt verwijderen?",remove:"Verwijderen"},fuelDash:{avgConsumption:"Gem. Verbruik",vehicles:"Voertuig",records:"records",totalKm:"Totaal KM",totalCost:"Totale Kosten",savingsTitle:"Besparingsanalyse",needMoreData:"Minimaal 10 records nodig voor analyse",improved:"Effici\xebntie Verbeterd",worsened:"Effici\xebntie Verslechterd",totalSavings:"Totale Besparing",baseline:"Basislijn",current:"Huidig",yearly:"Jaarlijkse Proj.",monthlyTrend:"Maandelijks Verbruikstrend",baselineLine:"Basislijn",vehicleRanking:"Voertuig Effici\xebntie",fleetAvg:"Vloot Gem.",excellent:"Uitstekend",good:"Goed",average:"Gemiddeld",poor:"Slecht",liters:"Liter",cost:"Kosten",vsFleet:"vs Vloot",viewDetail:"Bekijk Detail",alerts:"Waarschuwingen",co2Title:"CO\u2082 Voetafdruk",co2Emission:"CO\u2082 Uitstoot",treesNeeded:"Bomen Nodig",benchmark:"Sectorvergelijking",roiTitle:"TulipFleet Besparingsrapport",roiTitleNeg:"Effici\xebntie Waarschuwing",roiYearly:"Jaarlijkse projectie",roiExtra:"Extra kosten",roiMultiplier:"Rendement (ROI)",roiSaved:"voor u bespaard",roiMoreFuel:"meer brandstof verbruikt",roiThisPeriod:"TulipFleet bespaarde deze periode",roiFleetVs:"Uw vloot vergeleken met vorige periode",euTitle:"EU CSRD Naleving",euCompliant:"Conform",euFleetAvg:"Vloot Gem.",euLimit:"EU 2026 Limiet",euCompliantCount:"Conform",euOverLimit:"Boven Limiet",euVehicle:"voertuig",euImprovement:"{{percent}}% meer verbetering nodig voor EU 2026 doel",bmFleet:"Uw Vloot",bmSectorAvg:"Sector Gem.",bmBelow:"{{percent}}% onder sector",bmAbove:"{{percent}}% boven sector",bmYou:"U",driverScore:"score",noBadge:"Voer meer records in \u2192 verdien badges",unassigned:"Niet Toegewezen",emission:"Uitstoot",bmHeavyTruck:"Zware Vrachtwagen",bmMediumTruck:"Middelzware Vracht.",bmLightCommercial:"Licht Bedrijfsv.",bmVan:"Bestelwagen",bmCar:"Personenwagen"},privacy:{lastUpdated:"Laatst bijgewerkt",s1Title:"1. Inleiding",s1Body:"TulipFleet (\"wij\", \"ons\", \"onze\") exploiteert een wagenparkbeheerplatform met mobiele applicaties en IoT-apparaten. Dit Privacybeleid legt uit hoe wij uw persoonsgegevens verzamelen, gebruiken, opslaan en beschermen in overeenstemming met de Algemene Verordening Gegevensbescherming (AVG) en toepasselijke gegevensbeschermingswetten.",s2Title:"2. Gegevens die wij verzamelen",s2Body:"Wij verzamelen de volgende categorie\xebn gegevens:\n\n\u2022 Accountgegevens: Naam, e-mailadres, telefoonnummer, bedrijfsnaam\n\u2022 Voertuiggegevens: Kenteken, merk, model, brandstoftype, kilometerstand\n\u2022 Locatiegegevens: Realtime GPS-co\xf6rdinaten van IoT-apparaten in voertuigen\n\u2022 Rijgegevens: Snelheid, acceleratie-events, rempatronen, routegeschiedenis\n\u2022 Apparaatgegevens: ESP32-apparaat-ID's, firmwareversie, verbindingsstatus\n\u2022 Gebruiksgegevens: App-gebruikspatronen, functie-interacties, inlogtijden",s3Title:"3. Hoe wij uw gegevens gebruiken",s3Body:"Uw gegevens worden gebruikt voor:\n\n\u2022 Wagenparkbeheer: Realtime voertuigtracking, route-optimalisatie, taa\u043a\u0442oewijzing\n\u2022 Veiligheidsmonitoring: Detectie van hard remmen, acceleratie en impactgebeurtenissen\n\u2022 Rapportage: Wagenparkprestatie-rapporten, brandstofverbruikanalyses\n\u2022 Communicatie: Pushmeldingen voor taakupdates, waarschuwingen en systeemberichten\n\u2022 Serviceverbetering: Analyse van gebruikspatronen om het platform te verbeteren",s4Title:"4. Gegevensopslag en beveiliging",s4Body:"\u2022 Alle gegevens worden opgeslagen op beveiligde servers binnen de Europese Unie (Hetzner, Duitsland)\n\u2022 Gegevensoverdracht is versleuteld met TLS/SSL\n\u2022 MQTT-communicatie gebruikt TLS-versleuteling\n\u2022 Wachtwoorden worden gehasht met bcrypt\n\u2022 JWT-tokens worden gebruikt voor authenticatie met automatische verloopdatum\n\u2022 Locatiegegevens worden 7 dagen bewaard en daarna automatisch verwijderd\n\u2022 Regelmatige beveiligingsaudits en penetratietests worden uitgevoerd",s5Title:"5. Gegevens delen",s5Body:"Wij verkopen uw persoonsgegevens niet aan derden. Gegevens kunnen worden gedeeld met:\n\n\u2022 Uw bedrijfsbeheerder: Wagenparkmanagers kunnen voertuig- en chauffeurgegevens binnen hun organisatie bekijken\n\u2022 Google Maps API: Voor routeberekening en kaartweergave (geanonimiseerd)\n\u2022 Firebase: Voor pushmeldingverzending\n\u2022 Wettelijke vereisten: Wanneer vereist door wet- of regelgeving",s6Title:"6. Uw rechten (AVG)",s6Body:"Onder de AVG heeft u het recht op:\n\n\u2022 Inzage: Een kopie van uw persoonsgegevens opvragen\n\u2022 Rectificatie: Onjuiste persoonsgegevens corrigeren\n\u2022 Verwijdering: Verwijdering van uw persoonsgegevens verzoeken\n\u2022 Overdraagbaarheid: Uw gegevens ontvangen in een gestructureerd, machineleesbaar formaat\n\u2022 Beperking: De verwerking van uw gegevens beperken\n\u2022 Bezwaar: Bezwaar maken tegen gegevensverwerking op basis van gerechtvaardigde belangen\n\nOm deze rechten uit te oefenen, neem contact met ons op via: destek@tulipfleet.com",s7Title:"7. Contact",s7Body:"TulipFleet\nE-mail: destek@tulipfleet.com\nWebsite: https://tulipfleet.com\n\n\xa9 2025-2026 TulipFleet. Alle rechten voorbehouden."},adminDrivers:{filterAll:"Alle",filterAvailable:"Beschikbaar",filterOnTask:"Op taak",filterOffline:"Offline",vehicle:"Voertuig",tasks:"Taken",score:"Score",assignedVehicle:"Toegewezen voertuig",license:"Rijbewijs",phone:"Telefoon",emergency:"Noodgeval",totalKm:"Totaal KM",unnamed:"Naamloos",noDrivers:"Geen chauffeurs",noDriversDesc:"Geen chauffeurs gevonden",loading:"Chauffeurs laden...",loadError:"Laden mislukt",deleteDriver:"Chauffeur verwijderen",deleteConfirm:"Weet u zeker dat u deze chauffeur wilt verwijderen?",driverDeleted:"Chauffeur succesvol verwijderd",deleteF