op Name",stopAddress:"Stop Address",plannedArrival:"Planned Arrival",invalidCoords:"Invalid coordinates",noStops:"No stops added yet",coordinates:"Coordinates",removeStopConfirm:"Are you sure you want to remove this stop?",remove:"Remove"},fuelDash:{avgConsumption:"Avg. Consumption",vehicles:"Vehicle",records:"records",totalKm:"Total KM",totalCost:"Total Cost",savingsTitle:"Savings Analysis",needMoreData:"At least 10 records needed for analysis",improved:"Efficiency Improved",worsened:"Efficiency Declined",totalSavings:"Total Savings",baseline:"Baseline",current:"Current",yearly:"Yearly Proj.",monthlyTrend:"Monthly Consumption Trend",baselineLine:"Baseline",vehicleRanking:"Vehicle Efficiency",fleetAvg:"Fleet Avg.",excellent:"Excellent",good:"Good",average:"Average",poor:"Poor",liters:"Liters",cost:"Cost",vsFleet:"vs Fleet",viewDetail:"View Detail",alerts:"Alerts",co2Title:"Carbon Footprint",co2Emission:"CO\u2082 Emission",treesNeeded:"Trees Needed",benchmark:"Sector Comparison",roiTitle:"TulipFleet Savings Report",roiTitleNeg:"Efficiency Warning",roiYearly:"Yearly projection",roiExtra:"Extra cost",roiMultiplier:"Return on Investment (ROI)",roiSaved:"saved for you",roiMoreFuel:"more fuel consumed",roiThisPeriod:"TulipFleet saved you this period",roiFleetVs:"Your fleet compared to last period",euTitle:"EU CSRD Compliance",euCompliant:"Compliant",euFleetAvg:"Fleet Avg.",euLimit:"EU 2026 Limit",euCompliantCount:"Compliant",euOverLimit:"Over Limit",euVehicle:"vehicle",euImprovement:"{{percent}}% more improvement needed to reach EU 2026 target",bmFleet:"Your Fleet",bmSectorAvg:"Sector Avg.",bmBelow:"{{percent}}% below sector",bmAbove:"{{percent}}% above sector",bmYou:"You",driverScore:"score",noBadge:"Enter more records \u2192 earn badges",unassigned:"Unassigned",emission:"Emission",bmHeavyTruck:"Heavy Truck",bmMediumTruck:"Medium Truck",bmLightCommercial:"Light Commercial",bmVan:"Van",bmCar:"Car"},privacy:{lastUpdated:"Last updated",s1Title:"1. Introduction",s1Body:"TulipFleet (\"we\", \"our\", \"us\") operates a fleet management platform including mobile applications and IoT devices. This Privacy Policy explains how we collect, use, store, and protect your personal data in compliance with the General Data Protection Regulation (GDPR) and applicable data protection laws.",s2Title:"2. Data We Collect",s2Body:"We collect the following categories of data:\n\n\u2022 Account Information: Name, email address, phone number, company name\n\u2022 Vehicle Data: License plate, brand, model, fuel type, mileage\n\u2022 Location Data: Real-time GPS coordinates from IoT devices installed in vehicles\n\u2022 Driving Data: Speed, acceleration events, braking patterns, route history\n\u2022 Device Data: ESP32 device identifiers, firmware version, connectivity status\n\u2022 Usage Data: App usage patterns, feature interactions, login timestamps",s3Title:"3. How We Use Your Data",s3Body:"Your data is used for:\n\n\u2022 Fleet Management: Real-time vehicle tracking, route optimization, task assignment\n\u2022 Safety Monitoring: Detecting hard braking, acceleration, and impact events\n\u2022 Reporting: Generating fleet performance reports, fuel consumption analytics\n\u2022 Communication: Push notifications for task updates, alerts, and system messages\n\u2022 Service Improvement: Analyzing usage patterns to improve the platform",s4Title:"4. Data Storage & Security",s4Body:"\u2022 All data is stored on secure servers located within the European Union (Hetzner, Germany)\n\u2022 Data transmission is encrypted using TLS/SSL\n\u2022 MQTT communication uses TLS encryption\n\u2022 Passwords are hashed using bcrypt\n\u2022 JWT tokens are used for authentication with automatic expiry\n\u2022 Location data is retained for 7 days, then automatically purged\n\u2022 Regular security audits and penetration testing are conducted",s5Title:"5. Data Sharing",s5Body:"We do not sell your personal data to third parties. Data may be shared with:\n\n\u2022 Your Company Admin: Fleet managers can view vehicle and driver data within their organization\n\u2022 Google Maps API: For route calculation and map display (anonymized)\n\u2022 Firebase: For push notification delivery\n\u2022 Legal Requirements: When required by law or legal proceedings",s6Title:"6. Your Rights (GDPR)",s6Body:"Under GDPR, you have the right to:\n\n\u2022 Access: Request a copy of your personal data\n\u2022 Rectification: Correct inaccurate personal data\n\u2022 Erasure: Request deletion of your personal data\n\u2022 Portability: Receive your data in a structured, machine-readable format\n\u2022 Restriction: Restrict the processing of your data\n\u2022 Objection: Object to data processing based on legitimate interests\n\nTo exercise these rights, contact us at: destek@tulipfleet.com",s7Title:"7. Contact",s7Body:"TulipFleet\nEmail: destek@tulipfleet.com\nWebsite: https://tulipfleet.com\n\n\xa9 2025-2026 TulipFleet. All rights reserved."},adminDrivers:{filterAll:"All",filterAvailable:"Available",filterOnTask:"On Task",filterOffline:"Offline",vehicle:"Vehicle",tasks:"Tasks",score:"Score",assignedVehicle:"Assigned Vehicle",license:"License",phone:"Phone",emergency:"Emergency",totalKm:"Total KM",unnamed:"Unnamed",noDrivers:"No Drivers",noDriversDesc:"No drivers found",loading:"Loading drivers...",loadError:"Failed to load drivers",deleteDriver:"Delete Driver",deleteConfirm:"Are you sure you want to delete this driver?",driverDeleted:"Driver deleted successfully",deleteFailed:"Failed to delete driver"},adminVehicles:{filterAll:"All",filterAvailable:"Available",filterInUse:"In Use",filterOther:"Other",fuel:"Fuel",offline:"Offline",online:"Online",track:"Track",device:"Device",color:"Color",category:"Category",fuelType:"Fuel Type",tankCapacity:"Tank Capacity",lastMaint:"Last Maintenance",loading:"Loading vehicles...",loadError:"Failed to load vehicles",noVehicles:"No Vehicles",noVehiclesDesc:"No vehicles found",deleteVehicle:"Delete Vehicle",deleteConfirm:"Are you sure you want to delete this vehicle?",vehicleDeleted:"Vehicle deleted successfully",deleteFailed:"Failed to delete vehicle"},adminTasks:{filterAll:"All",filterPending:"Pending",filterActive:"Active",filterCompleted:"Completed",driver:"Driver",noDriver:"No Driver",noDriverAssigned:"No driver assigned",noVehicle:"No Vehicle",distance:"Distance",from:"From",to:"To",scheduled:"Scheduled",notes:"Notes",description:"Description",priorityLabel:"Priority",sendOffer:"Send Offer",sendOfferConfirm:"Send this task offer to the driver?",send:"Send",offerSent:"Offer sent successfully",offerFailed:"Failed to send offer",loading:"Loading tasks...",loadError:"Failed to load tasks",noTasks:"No Tasks",noTasksDesc:"No tasks found",deleteTask:"Delete Task",deleteConfirm:"Are you sure you want to delete this task?",taskDeleted:"Task deleted successfully",deleteFailed:"Failed to delete task"},adminAlerts:{filterAll:"All",filterActive:"Active",filterResolved:"Resolved",statusActive:"Active",statusResolved:"Resolved",resolve:"Resolve",resolveBtn:"Resolve",resolveConfirm:"Mark this alert as resolved?",resolved:"Alert resolved",resolveFailed:"Failed to resolve alert",alreadyResolved:"Already resolved",deleteAlert:"Delete Alert",deleteConfirm:"Are you sure you want to delete this alert?",alertDeleted:"Alert deleted successfully",deleteFailed:"Failed to delete alert",deleteAll:"Delete All",deleteAllBtn:"Delete All",deleteAllConfirm:"{{count}} alerts will be deleted. Are you sure?",allDeleted:"All alerts deleted",deleteAllFailed:"Failed to delete alerts",noAlertsToDelete:"No alerts to delete",loading:"Loading alerts...",loadError:"Failed to load alerts",noAlerts:"No Alerts",noAlertsDesc:"No alerts found",types:{hardBrake:"Hard Braking",hardAccel:"Hard Acceleration",hardTurn:"Hard Turn",sharpTurn:"Sharp Turn",impact:"Impact",overspeed:"Overspeed",speed:"Overspeed",geofence:"Zone Alert",geofenceEntry:"Zone Entry",geofenceExit:"Zone Exit",fuel:"Fuel",maintenance:"Maintenance",battery:"Battery",idle:"Idle",sos:"SOS",default:"Alert"},time:{justNow:"Just now",minsAgo:"{{count}} min ago",hoursAgo:"{{count}} hr ago",daysAgo:"{{count}} day ago"},filterCritical:"Critical",filterVehicle:"Vehicle"},createDriver:{accountInfo:"Account Info",email:"Email",password:"Password",passwordPlaceholder:"At least 6 characters",personalInfo:"Personal Info",firstName:"First Name",lastName:"Last Name",phone:"Phone",licenseInfo:"License Info",licenseNo:"License No",licenseExpiry:"License Expiry",emergency:"Emergency Contact",emergencyContact:"Emergency Contact (Name - Phone)",addDriver:"Add Driver",success:"\u2705 Success",driverAdded:"Driver added successfully",error:"Error",emailRequired:"Email is required",passwordRequired:"Password is required",passwordMinLength:"Password must be at least 6 characters",licenseRequired:"License number is required",createFailed:"Failed to create driver"},camera:{permissionDenied:"Camera permission denied",grantPermission:"Grant Permission",enableInSettings:"Please enable camera access in settings",requestingPermission:"Requesting camera permission..."},reports:{loading:"Loading reports...",noData:"Could not load data",fleetStatus:"Fleet Status",taskSummary:"Task Summary",alertSummary:"Alert Summary",totalVehicles:"Total Vehicles",totalDrivers:"Total Drivers",totalTasks:"Total Tasks",completed:"Completed",totalAlerts:"Total Alerts",criticalAlerts:"Critical Alerts",active:"active",resolved:"resolved",vehiclePerformance:"Vehicle Performance",driverPerformance:"Driver Performance",alertDistribution:"Alert Distribution",taskDistribution:"Task Distribution",noVehicleData:"No vehicle data",noDriverData:"No driver data",noAlertData:"No alert data",noTaskData:"No task data",noAlertsInPeriod:"No alerts in this period",noTasksInPeriod:"No tasks in this period",statusActive:"Active",statusAvailable:"Available",statusInactive:"Inactive",tasks:"Tasks",alerts:"Alerts",success:"Success",last7Days:"Last 7 Days",last30Days:"Last 30 Days",last90Days:"Last 90 Days",tabs:{summa