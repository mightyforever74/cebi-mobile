 \u043d\u0430\u0434 \u0441\u0435\u043a\u0442\u043e\u0440\u0430",bmYou:"\u0412\u0438\u0435",driverScore:"\u0442\u043e\u0447\u043a\u0438",noBadge:"\u0412\u044a\u0432\u0435\u0434\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0447\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u2192 \u0441\u043f\u0435\u0447\u0435\u043b\u0435\u0442\u0435 \u0437\u043d\u0430\u0447\u043a\u0438",unassigned:"\u041d\u0435\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d",emission:"\u0415\u043c\u0438\u0441\u0438\u044f",bmHeavyTruck:"\u0422\u0435\u0436\u043a\u043e\u0442\u043e\u0432\u0430\u0440\u0435\u043d",bmMediumTruck:"\u0421\u0440\u0435\u0434\u0435\u043d \u041a\u0430\u043c\u0438\u043e\u043d",bmLightCommercial:"\u041b\u0435\u043a \u0422\u044a\u0440\u0433\u043e\u0432\u0441\u043a\u0438",bmVan:"\u041c\u0438\u043a\u0440\u043e\u0431\u0443\u0441",bmCar:"\u041b\u0435\u043a\u0430 \u041a\u043e\u043b\u0430"},privacy:{lastUpdated:"\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f",s1Title:"1. \u0412\u044a\u0432\u0435\u0434\u0435\u043d\u0438\u0435",s1Body:"TulipFleet (\"\u043d\u0438\u0435\", \"\u043d\u0430\u0448\") \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0432\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0430\u0432\u0442\u043e\u043f\u0430\u0440\u043a, \u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0449\u0430 \u043c\u043e\u0431\u0438\u043b\u043d\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 IoT \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430. \u0422\u0430\u0437\u0438 \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0437\u0430 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 \u043e\u0431\u044f\u0441\u043d\u044f\u0432\u0430 \u043a\u0430\u043a \u0441\u044a\u0431\u0438\u0440\u0430\u043c\u0435, \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043c\u0435, \u0441\u044a\u0445\u0440\u0430\u043d\u044f\u0432\u0430\u043c\u0435 \u0438 \u0437\u0430\u0449\u0438\u0442\u0430\u0432\u0430\u043c\u0435 \u0432\u0430\u0448\u0438\u0442\u0435 \u043b\u0438\u0447\u043d\u0438 \u0434\u0430\u043d\u043d\u0438 \u0432 \u0441\u044a\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0441 \u041e\u0431\u0449\u0438\u044f \u0440\u0435\u0433\u043b\u0430\u043c\u0435\u043d\u0442 \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0430 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 (GDPR) \u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043c\u0438\u0442\u0435 \u0437\u0430\u043a\u043e\u043d\u0438 \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0430 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435.",s2Title:"2. \u0414\u0430\u043d\u043d\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u044a\u0431\u0438\u0440\u0430\u043c\u0435",s2Body:"\u0421\u044a\u0431\u0438\u0440\u0430\u043c\u0435 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u0434\u0430\u043d\u043d\u0438:\n\n\u2022 \u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0437\u0430 \u0430\u043a\u0430\u0443\u043d\u0442\u0430: \u0418\u043c\u0435, \u0438\u043c\u0435\u0439\u043b \u0430\u0434\u0440\u0435\u0441, \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435\u043d \u043d\u043e\u043c\u0435\u0440, \u0438\u043c\u0435 \u043d\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u0442\u0430\n\u2022 \u0414\u0430\u043d\u043d\u0438 \u0437\u0430 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u043e\u0442\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e: \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u0435\u043d \u043d\u043e\u043c\u0435\u0440, \u043c\u0430\u0440\u043a\u0430, \u043c\u043e\u0434\u0435\u043b, \u0432\u0438\u0434 \u0433\u043e\u0440\u0438\u0432\u043e, \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u0430\u0436\n\u2022 \u0414\u0430\u043d\u043d\u0438 \u0437\u0430 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e: GPS \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u0438 \u0432 \u0440\u0435\u0430\u043b\u043d\u043e \u0432\u0440\u0435\u043c\u0435 \u043e\u0442 IoT \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0438 \u0432 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u0438\u0442\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u2022 \u0414\u0430\u043d\u043d\u0438 \u0437\u0430 \u0448\u043e\u0444\u0438\u0440\u0430\u043d\u0435: \u0421\u043a\u043e\u0440\u043e\u0441\u0442, \u0441\u044a\u0431\u0438\u0442\u0438\u044f \u043d\u0430 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435, \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0430 \u0441\u043f\u0438\u0440\u0430\u043d\u0435, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430\n\u2022 \u0414\u0430\u043d\u043d\u0438 \u0437\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e: \u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u0438 \u043d\u0430 ESP32 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e, \u0432\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u0444\u044a\u0440\u043c\u0443\u0435\u0440\u0430, \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u043e\u0441\u0442\n\u2022 \u0414\u0430\u043d\u043d\u0438 \u0437\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435: \u041c\u043e\u0434\u0435\u043b\u0438 \u043d\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e, \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u0432\u0438 \u043c\u0430\u0440\u043a\u0435\u0440\u0438 \u0437\u0430 \u0432\u043b\u0438\u0437\u0430\u043d\u0435",s3Title:"3. \u041a\u0430\u043a \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043c\u0435 \u0432\u0430\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u0438",s3Body:"\u0412\u0430\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u0438 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430:\n\n\u2022 \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0430\u0432\u0442\u043e\u043f\u0430\u0440\u043a\u0430: \u041f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432 \u0440\u0435\u0430\u043b\u043d\u043e \u0432\u0440\u0435\u043c\u0435, \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430, \u0432\u044a\u0437\u043b\u0430\u0433\u0430\u043d\u0435 \u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0438\n\u2022 \u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u043d\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0442\u0430: \u041e\u0442\u043a\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0440\u044f\u0437\u043a\u043e \u0441\u043f\u0438\u0440\u0430\u043d\u0435, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0438 \u0443\u0434\u0430\u0440\u0438\n\u2022 \u041e\u0442\u0447\u0438\u0442\u0430\u043d\u0435: \u0413\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043e\u0442\u0447\u0435\u0442\u0438 \u0437\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0430\u0432\u0442\u043e\u043f\u0430\u0440\u043a\u0430, \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u043d\u0430 \u0440\u0430\u0437\u0445\u043e\u0434\u0430 \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e\n\u2022 \u041a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f: Push \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f \u0437\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0438, \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0438 \u0441\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u044f\n\u2022 \u041f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0443\u0441\u043b\u0443\u0433\u0430\u0442\u0430: \u0410\u043d\u0430\u043b\u0438\u0437 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u0438\u0442\u0435 \u043d\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0442\u0430",s4Title:"4. \u0421\u044a\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0438 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435",s4Body:"\u2022 \u0412\u0441\u0438\u0447\u043a\u0438 \u0434\u0430\u043d\u043d\u0438 \u0441\u0435 \u0441\u044a\u0445\u0440\u0430\u043d\u044f\u0432\u0430\u0442 \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0435\u043d\u0438 \u0441\u044a\u0440\u0432\u044a\u0440\u0438 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u044f \u0441\u044a\u044e\u0437 (Hetzner, \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f)\n\u2022 \u041f\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0434\u0430\u043d\u043d\u0438 \u0435 \u043a\u0440\u0438\u043f\u0442\u0438\u0440\u0430\u043d\u043e \u0441 TLS/SSL\n\u2022 MQTT \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f\u0442\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 TLS \u043a\u0440\u0438\u043f\u0442\u0438\u0440\u0430\u043d\u0435\n\u2022 \u041f\u0430\u0440\u043e\u043b\u0438\u0442\u0435 \u0441\u0430 \u0445\u0435\u0448\u0438\u0440\u0430\u043d\u0438 \u0441 bcrypt\n\u2022 JWT \u0442\u043e\u043a\u0435\u043d\u0438 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0437\u0430 \u0443\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u044f\u0432\u0430\u043d\u0435 \u0441 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0438\u0437\u0442\u0438\u0447\u0430\u043d\u0435\n\u2022 \u0414\u0430\u043d\u043d\u0438\u0442\u0435 \u0437\u0430 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u0441\u0435 \u0441\u044a\u0445\u0440\u0430\u043d\u044f\u0432\u0430\u0442 7 \u0434\u043d\u0438, \u0441\u043b\u0435\u0434 \u043a\u043e\u0435\u0442\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u0435 \u0438\u0437\u0442\u0440\u0438\u0432\u0430\u0442\n\u2022 \u041f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442 \u0441\u0435 \u0440\u0435\u0434\u043e\u0432\u043d\u0438 \u043e\u0434\u0438\u0442\u0438 \u0437\u0430 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0438 \u0442\u0435\u0441\u0442\u043e\u0432\u0435 \u0437\u0430 \u043f\u0440\u043e\u043d\u0438\u043a\u0432\u0430\u043d\u0435",s5Title:"5. \u0421\u043f\u043e\u0434\u0435\u043b\u044f\u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438",s5Body:"\u041d\u0438\u0435 \u043d\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043c\u0435 \u0432\u0430\u0448\u0438\u0442\u0435 \u043b\u0438\u0447\u043d\u0438 \u0434\u0430\u043d\u043d\u0438 \u043d\u0430 \u0442\u0440\u0435\u0442\u0438 \u0441\u0442\u0440\u0430\u043d\u0438. \u0414\u0430\u043d\u043d\u0438\u0442\u0435 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0431\u044a\u0434\u0430\u0442 \u0441\u043f\u043e\u0434\u0435\u043b\u0435\u043d\u0438 \u0441:\n\n\u2022 \u0412\u0430\u0448\u0438\u044f\u0442 \u0444\u0438\u0440\u043c\u0435\u043d \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440: \u041c\u0435\u043d\u0438\u0434\u0436\u044a\u0440\u0438\u0442\u0435 \u043d\u0430 \u0430\u0432\u0442\u043e\u043f\u0430\u0440\u043a\u0430 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u043f\u0440\u0435\u0433\u043b\u0435\u0436\u0434\u0430\u0442 \u0434\u0430\u043d\u043d\u0438 \u0437\u0430 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438 \u0448\u043e\u0444\u044c\u043e\u0440\u0438 \u0432 \u0442\u044f\u0445\u043d\u0430\u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\n\u2022 Google Maps API: \u0417\u0430 \u0438\u0437\u0447\u0438\u0441\u043b\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438 \u0438 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u0438 (\u0430\u043d\u043e\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0430\u043d\u043e)\n\u2022 Firebase: \u0417\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430 push \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f\n\u2022 \u0417\u0430\u043a\u043e\u043d\u043e\u0432\u0438 \u0438\u0437\u0438\u0441\u043a\u0432\u0430\u043d\u0438\u044f: \u041a\u043e\u0433\u0430\u0442\u043e \u0441\u0435 \u0438\u0437\u0438\u0441\u043a\u0432\u0430 \u043e\u0442 \u0437\u0430\u043a\u043e\u043d\u0430 \u0438\u043b\u0438 \u043f\u0440\u0430\u0432\u043d\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430",s6Title:"6. \u0412\u0430\u0448\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u0430 (GDPR)",s6Body:"\u0421\u044a\u0433\u043b\u0430\u0441\u043d\u043e GDPR \u0438\u043c\u0430\u0442\u0435 \u043f\u0440\u0430\u0432\u043e \u043d\u0430:\n\n\u2022 \u0414\u043e\u0441\u0442\u044a\u043f: \u0417\u0430\u044f\u0432\u043a\u0430 \u0437\u0430 \u043a\u043e\u043f\u0438\u0435 \u043d\u0430 \u0432\u0430\u0448\u0438\u0442\u0435 \u043b\u0438\u0447\u043d\u0438 \u0434\u0430\u043d\u043d\u0438\n\u2022 \u041a\u043e\u0440\u0438\u0433\u0438\u0440\u0430\u043d\u0435: \u041a\u043e\u0440\u0438\u0433\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043d\u0435\u0442\u043e\u0447\u043d\u0438 \u043b\u0438\u0447\u043d\u0438 \u0434\u0430\u043d\u043d\u0438\n\u2022 \u0418\u0437\u0442\u0440\u0438\u0432\u0430\u043d\u0435: \u0417\u0430\u044f\u0432\u043a\u0430 \u0437\u0430 \u0438\u0437\u0442\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0430\u0448\u0438\u0442\u0435 \u043b\u0438\u0447\u043d\u0438 \u0434\u0430\u043d\u043d\u0438\n\u2022 \u041f\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442: \u041f\u043e\u043b\u0443\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u0432\u0438 \u0432 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u0430\u043d, \u043c\u0430\u0448\u0438\u043d\u043d\u043e \u0447\u0435\u0442\u0438\u043c \u0444\u043e\u0440\u043c\u0430\u0442\n\u2022 \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u043d\u0435: \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430\u0442\u0430 \u043d\u0430 \u0432\u0430\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u0438\n\u2022 \u0412\u044a\u0437\u0440\u0430\u0436\u0435\u043d\u0438\u0435: \u0412\u044a\u0437\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u0440\u0435\u0449\u0443 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u0437\u0430\u043a\u043e\u043d\u043d\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0438\n\n\u0417\u0430 \u0443\u043f\u0440\u0430\u0436\u043d\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0442\u0435\u0437\u0438 \u043f\u0440\u0430\u0432\u0430 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441 \u043d\u0430\u0441 \u043d\u0430: destek@tulipfleet.com",s7Title:"7. \u041a\u043e\u043d\u0442\u0430\u043a\u0442",s7Body:"TulipFleet\n\u0418\u043c\u0435\u0439\u043b: destek@tulipfleet.com\n\u0423\u0435\u0431\u0441\u0430\u0439\u0442: https://tulipfleet.com\n\n\xa9 2025-2026 TulipFleet. \u0412\u0441\u0438\u0447\u043a\u0438 \u043f\u0440\u0430\u0432\u0430 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438."},device:{title: