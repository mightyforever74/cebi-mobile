u0442\u0435 \u043a\u0435\u0448\u0430."},steps:{checkPowerConnection:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0432\u0440\u044a\u0437\u043a\u0430\u0442\u0430 \u043d\u0430 \u0437\u0430\u0445\u0440\u0430\u043d\u0432\u0430\u0449\u0438\u044f \u043a\u0430\u0431\u0435\u043b",checkFuse:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u043f\u0440\u0435\u0434\u043f\u0430\u0437\u0438\u0442\u0435\u043b\u044f \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0430",checkVoltage:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 12V-24V",moveOutdoors:"\u041f\u0440\u0435\u043c\u0435\u0441\u0442\u0435\u0442\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430\u0432\u044a\u043d",checkAntenna:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0432\u0440\u044a\u0437\u043a\u0430\u0442\u0430 \u043d\u0430 GPS \u0430\u043d\u0442\u0435\u043d\u0430\u0442\u0430",avoidMetal:"\u041e\u0442\u0434\u0430\u043b\u0435\u0447\u0435\u0442\u0435 \u0441\u0435 \u043e\u0442 \u043c\u0435\u0442\u0430\u043b\u043d\u0438 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f",checkPassword:"\u0423\u0432\u0435\u0440\u0435\u0442\u0435 \u0441\u0435, \u0447\u0435 \u043f\u0430\u0440\u043e\u043b\u0430\u0442\u0430 \u0437\u0430 WiFi \u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043d\u0430",use24Ghz:"\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 2.4GHz \u043c\u0440\u0435\u0436\u0430 (5GHz \u043d\u0435 \u0441\u0435 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430)",checkSignal:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0441\u0438\u043b\u0430\u0442\u0430 \u043d\u0430 WiFi \u0441\u0438\u0433\u043d\u0430\u043b\u0430",restartDevice:"\u0420\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0439\u0442\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e",connect60sec:"\u041e\u043f\u0438\u0442\u0430\u0439\