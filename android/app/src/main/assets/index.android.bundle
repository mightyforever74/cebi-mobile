ailed:"No se pudo guardar el registro"},confirmNotFull:{title:"Atenci\xf3n",message:"Si el tanque no est\xe1 LLENO, esta entrada se excluye del an\xe1lisis de consumo. \xbfContinuar?",cancel:"Cancelar",proceed:"Guardar de todos modos"},submit:{save:"Guardar"},success:{title:"\xc9xito",saved:"Guardado",kmTraveled:"{{km}} km",consumptionPer100km:"{{value}} L/100km",costPerKm:"{{value}}/km",message:"\xa1Guardado!"},calculation:"Vista previa del c\xe1lculo",consumption:"Consumo",costPerKm:"Costo por km",costPlaceholder:"p. ej. 150",currentOdometer:"Od\xf3metro",editVehicle:"Editar informaci\xf3n del veh\xedculo",error:{loadFailed:"Failed to load vehicle info",noVehicle:"No vehicle assigned",saveFailed:"Failed to save record",title:"Error",vehicleUpdateFailed:"Failed to update vehicle info"},firstRecordNote:"Este es el primer registro; el consumo se calcular\xe1 en la siguiente entrada.",fuelType:"Tipo de combustible",fuelTypes:{diesel:"Di\xe9sel",electric:"El\xe9ctrico",gasoline:"Gasolina",lpg:"GLP"},fullTankNote:"Llene el tanque por completo",isFullTank:"Tanque lleno",kmTraveled:"Distancia recorrida",lastOdometer:"\xdaltimo",lastRecord:"\xdaltimo registro",litersFilled:"Litros cargados",litersPlaceholder:"p. ej. 52",notFullTankWarning:{cancel:"Cancelar",message:"Si el tanque no est\xe1 lleno, este registro no se incluir\xe1 en el an\xe1lisis de consumo. \xbfDesea continuar?",saveAnyway:"Guardar de todos modos",title:"Advertencia"},odometerPlaceholder:"p. ej. 100.520",plate:"Matr\xedcula",plateReadonly:"La matr\xedcula no se puede cambiar",pricePerLiter:"Precio por litro",save:"GUARDAR",tankCapacity:"Tanque",title:"Registro de combustible",totalCost:"Total Cost",validation:{consumptionUnrealistic:"El consumo calculado ({{value}} L/100km) parece poco realista",kmTooHigh:"{{km}} km en una sola carga parece demasiado alto",litersExceedsTank:"Maximum {{capacity}}L allowed",litersRequired:"Liters amount is required",odometerMustBeHigher:"Odometer must be higher than previous record ({{lastKm}})",odometerRequired:"Odometer reading is required"},vehicleInfo:"Informaci\xf3n del veh\xedculo",vehicleUpdated:"Informaci\xf3n del veh\xedculo actualizada"},help:{title:"Centro de Ayuda",subtitle:"Preguntas frecuentes y gu\xeda",heroTitle:"\xbfC\xf3mo podemos ayudarte?",heroSubtitle:"Consulta las preguntas frecuentes",heroHint:"Toca una categor\xeda para ver las preguntas",quickHelp:"Ayuda r\xe1pida",troubleshooting:"Soluci\xf3n de problemas",ledIndicators:"Indicadores LED",faqTitle:"Preguntas Frecuentes",questionCount:"preguntas",account:{title:"Cuenta e inicio de sesi\xf3n",q1:"\xbfC\xf3mo puedo cambiar mi contrase\xf1a?",a1:"Ve a Ajustes > Cambiar contrase\xf1a, introduce tu contrase\xf1a actual y establece una nueva.",q2:"No puedo iniciar sesi\xf3n, \xbfqu\xe9 debo hacer?",a2:"Verifica tu correo electr\xf3nico. Si olvidaste tu contrase\xf1a, usa la opci\xf3n \"Olvid\xe9 mi contrase\xf1a\" o contacta con soporte.",q3:"\xbfC\xf3mo actualizo la informaci\xf3n de mi perfil?",a3:"Ve a Ajustes > Editar perfil para actualizar tu nombre, apellido y n\xfamero de tel\xe9fono."},vehicles:{title:"Veh\xedculos y seguimiento",q1:"\xbfC\xf3mo puedo ver la ubicaci\xf3n de mi veh\xedculo?",a1:"Puedes ver la ubicaci\xf3n en tiempo real en el mapa del panel. Se actualiza cada 5 segundos.",q2:"Mi veh\xedculo aparece desconectado, \xbfqu\xe9 debo hacer?",a2:"Verifica la conexi\xf3n de alimentaci\xf3n del GPS. Revisa los indicadores LED. Verifica tambi\xe9n la conexi\xf3n a internet.",q3:"\xbfPuedo rastrear varios veh\xedculos a la vez?",a3:"S\xed, puedes ver todos tus veh\xedculos en la pantalla Mapa en vivo del panel de administrador."},tasks:{title:"Tareas",q1:"\xbfC\xf3mo acepto una tarea asignada?",a1:"Ve la tarea entrante en el panel y pulsa \"Aceptar\". Usa \"Iniciar tarea\" para comenzar.",q2:"\xbfC\xf3mo marco una tarea como completada?",a2:"Ve a los detalles de la tarea y pulsa \"Completar tarea\". Rellena la informaci\xf3n requerida y confirma.",q3:"\xbfPuedo rechazar una tarea asignada?",a3:"S\xed, abre la tarea y usa la opci\xf3n \"Rechazar\". Se te pedir\xe1 indicar un motivo."},technical:{title:"Soporte t\xe9cnico",q1:"\xbfC\xf3mo instalo el dispositivo GPS?",a1:"Conecta el dispositivo al puerto USB del veh\xedculo. Escanea el c\xf3digo QR en la app y completa la configuraci\xf3n WiFi por BLE.",q2:"El dispositivo no se conecta al WiFi, \xbfqu\xe9 debo hacer?",a2:"Aseg\xfarate de usar una red WiFi de 2.4 GHz (5 GHz no compatible). Verifica la contrase\xf1a. Reinicia el dispositivo y conecta en 60 segundos.",q3:"\xbfQu\xe9 significan las luces LED?",a3:"Verde fijo: sistema funcionando. Azul intermitente: modo BLE. Amarillo: buscando GPS. Rojo: error. Consulta la p\xe1gina de Indicadores LED."},contact:{title:"\xbfA\xfan necesitas ayuda?",subtitle:"Si tu pregunta no est\xe1 aqu\xed, contacta a nuestro equipo de soporte",button:"Contactar al Equipo de Soporte"},footer:"\xa9 2025 TulipFleet - Todos los derechos reservados"},troubleshooting:{title:"Soluci\xf3n de Problemas",tapToExpand:"Toca para ver detalles",solution:"Soluci\xf3n",stepsToTry:"Pasos a Intentar",stillNeedHelp:"\xbfA\xfan necesitas ayuda?",contactUs:"Contacta a nuestro equipo de soporte t\xe9cnico",problems:{noPower:"El dispositivo no enciende",noGps:"Sin se\xf1al GPS",noWifi:"Error de conexi\xf3n WiFi",noBle:"Bluetooth no encontrado",noUpdate:"La ubicaci\xf3n no se actualiza",appCrash:"La app se cierra"},solutions:{noPower:"Verifica la conexi\xf3n de energ\xeda y el fusible.",noGps:"Orienta la antena GPS hacia cielo abierto.",noWifi:"Verifica la contrase\xf1a y configuraci\xf3n de red.",noBle:"Reinicia el dispositivo y conecta en 60 segundos.",noUpdate:"Verifica la conexi\xf3n a internet y estado del servidor.",appCrash:"Actualiza la app o limpia la cach\xe9."},steps:{checkPowerConnection:"Verifica la conexi\xf3n del cable de alimentaci\xf3n",checkFuse:"Revisa el fusible del veh\xedculo",checkVoltage:"Verifica el rango de voltaje 12V-24V",moveOutdoo