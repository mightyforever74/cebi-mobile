,priorityUrgent:"Urgente",selectDriver:"Seleccionar Conductor",selectVehicle:"Seleccionar Veh\xedculo",route:"Ruta",startLocation:"Direcci\xf3n de inicio",endLocation:"Direcci\xf3n de destino",startDate:"Inicio",endDate:"Fin",submit:"Crear Tarea",success:"\xc9xito",taskCreated:"Tarea creada con \xe9xito",taskCreateError:"Error al crear la tarea",validationEnterTitle:"Ingrese el t\xedtulo de la tarea",validationEnterStart:"Ingrese la ubicaci\xf3n de inicio",validationEnterEnd:"Ingrese el destino",validationEndAfterStart:"La hora de fin debe ser posterior a la de inicio",noOptions:"No se encontraron opciones",templateDelivery:"Entrega",templateTransfer:"Transferencia",templateService:"Servicio",templateWarehouse:"Almac\xe9n",assignment:"Asignaci\xf3n",schedule:"Horario",duration:"Duraci\xf3n",driver:"Conductor",vehicle:"Veh\xedculo",date:"Fecha",time:"Hora",start:"Inicio",end:"Fin",done:"Hecho",cancel:"Cancelar"},editTask:{title:"Editar Tarea",save:"Guardar",taskUpdated:"Tarea actualizada con \xe9xito",taskUpdateError:"Error al actualizar la tarea",selectDriver:"Seleccione un conductor",selectVehicle:"Seleccione un veh\xedculo",status:"Estado",statusPending:"Pendiente",statusAssigned:"Asignada",statusInProgress:"En Progreso",statusCompleted:"Completada",statusCancelled:"Cancelada",startLocation:"Direcci\xf3n de inicio",endLocation:"Direcci\xf3n de destino",dataLoadError:"Error al cargar datos"},waypointEditor:{title:"Paradas",addStop:"Agregar Parada",limitReached:"L\xedmite de paradas alcanzado",stopName:"Nombre de Parada",stopAddress:"Direcci\xf3n de Parada",plannedArrival:"Llegada Planificada",invalidCoords:"Coordenadas inv\xe1lidas",noStops:"A\xfan no se han agregado paradas",coordinates:"Coordenadas",removeStopConfirm:"\xbfEst\xe1 seguro de que desea eliminar esta parada?",remove:"Eliminar"},fuelDash:{avgConsumption:"Consumo Medio",vehicles:"Veh\xedculo",records:"registros",totalKm:"Total KM",totalCost:"Coste Total",savingsTitle:"An\xe1lisis de Ahorro",needMoreData:"Se necesitan al menos 10 registros para el an\xe1lisis",improved:"Eficiencia Mejorada",worsened:"Eficiencia Empeorada",totalSavings:"Ahorro Total",baseline:"Base",current:"Actual",yearly:"Proy. Anual",monthlyTrend:"Tendencia Mensual de Consumo",baselineLine:"Base",vehicleRanking:"Eficiencia de Veh\xedculos",fleetAvg:"Prom. Flota",excellent:"Excelente",good:"Bueno",average:"Normal",poor:"Malo",liters:"Litros",cost:"Coste",vsFleet:"vs Flota",viewDetail:"Ver Detalle",alerts:"Alertas",co2Title:"Huella de CO\u2082",co2Emission:"Emisi\xf3n CO\u2082",treesNeeded:"\xc1rboles Necesarios",benchmark:"Comparaci\xf3n Sectorial",roiTitle:"Informe de Ahorro TulipFleet",roiTitleNeg:"Alerta de Eficiencia",roiYearly:"Proyecci\xf3n anual",roiExtra:"Coste extra",roiMultiplier:"Retorno de Inversi\xf3n (ROI)",roiSaved:"ahorrado para ti",roiMoreFuel:"m\xe1s combustible consumido",roiThisPeriod:"TulipFleet te ahorr\xf3 este per\xedodo",roiFleetVs:"Tu flota comparada con el per\xedodo anterior",euTitle:"Cumplimiento EU CSRD",euCompliant:"Conforme",euFleetAvg:"Prom. Flota",euLimit:"L\xedmite EU 2026",euCompliantCount:"Conforme",euOverLimit:"Sobre L\xedmite",euVehicle:"veh\xedculo",euImprovement:"Se necesita {{percent}}% m\xe1s mejora para el objetivo EU 2026",bmFleet:"Tu Flota",bmSectorAvg:"Prom. Sector",bmBelow:"{{percent}}% por debajo del sector",bmAbove:"{{percent}}% por encima del sector",bmYou:"T\xfa",driverScore:"puntos",noBadge:"Introduce m\xe1s registros \u2192 gana insignias",unassigned:"Sin Asignar",emission:"Emisi\xf3n",bmHeavyTruck:"Cami\xf3n Pesado",bmMediumTruck:"Cami\xf3n Mediano",bmLightCommercial:"Veh\xedculo Comercial",bmVan:"Furgoneta",bmCar:"Coche"},navigation:{fuelAnalysis:"An\xe1lisis Combustible",platformUsers:"Usuarios",systemHealth:"Estado Sistema",logout:"Cerrar Sesi\xf3n",logoutConfirm:"\xbfEst\xe1s seguro de que quieres cerrar sesi\xf3n?",geofences:"Zonas Geofence",alerts:"Alertas",companies:"Empresas",dashboard:"Panel",deviceSetup:"Configuraci\xf3n del dispositivo",devices:"Dispositivos",drivers:"Conductores",fleetMap:"Mapa en vivo",fuelEntry:"Registro de combustible",myTasks:"Mis tareas",myVehicle:"Mi veh\xedculo",navigation:"Navegaci\xf3n",profile:"Perfil",qrManagement:"Gesti\xf3n de QR",reports:"Informes",settings:"Configuraci\xf3n",sos:"Emergency",taskHistory:"Historial de tareas",tasks:"Tareas",vehicles:"Veh\xedculos"},privacy:{lastUpdated:"\xdaltima actualizaci\xf3n",s1Title:"1. Introducci\xf3n",s1Body:"TulipFleet (\"nosotros\", \"nuestro\") opera una plataforma de gesti\xf3n de flotas que incluye aplicaciones m\xf3viles y dispositivos IoT. Esta Pol\xedtica de Privacidad explica c\xf3mo recopilamos, utilizamos, almacenamos y protegemos sus datos personales en cumplimiento con el Reglamento General de Protecci\xf3n de Datos (RGPD) y las leyes de protecci\xf3n de datos aplicables.",s2Title:"2. Datos que recopilamos",s2Body:"Recopilamos las siguientes categor\xedas de datos:\n\n\u2022 Informaci\xf3n de la cuenta: Nombre, direcci\xf3n de correo electr\xf3nico, n\xfamero de tel\xe9fono, nombre de la empresa\n\u2022 Datos del veh\xedculo: Matr\xedcula, marca, modelo, tipo de combustible, kilometraje\n\u2022 Datos de ubicaci\xf3n: Coordenadas GPS en tiempo real de dispositivos IoT instalados en veh\xedculos\n\u2022 Datos de conducci\xf3n: Velocidad, eventos de aceleraci\xf3n, patrones de frenado, historial de rutas\n\u2022 Datos del dispositivo: Identificadores de dispositivo ESP32, versi\xf3n de firmware, estado de conexi\xf3n\n\u2022 Datos de uso: Patrones de uso de la app, interacciones con funciones, marcas de tiempo de inicio de sesi\xf3n",s3Title:"3. C\xf3mo utilizamos sus datos",s3Body:"Sus datos se utilizan para:\n\n\u2022 Gesti\xf3n de flota: Seguimiento de veh\xedculos en tiempo real, optimizaci\xf3n de rutas, asignaci\xf3n de tareas\n\u2022 Monitoreo de seguridad: Detecci\xf3n de frenados bruscos, aceleraciones y eventos de impacto\n\u2022 Informes: Generaci\xf3n de informes de rendimiento de la flota, an\xe1lisis de consumo de combustible\n\u2022 Comunicaci\xf3n: Notificaciones push para actualizaciones de tareas, alertas y mensajes del sistema\n\u2022 Mejora del servicio: An\xe1lisis de patrones de uso para mejorar la plataforma",s4Title:"4. Almacenamiento y seguridad de datos",s4Body:"\u2022 Todos los datos se almacenan en servidores seguros ubicados en la Uni\xf3n Europea (Hetzner, Alemania)\n\u2022 La transmisi\xf3n de datos est\xe1 cifrada con TLS/SSL\n\u2022 La comunicaci\xf3n MQTT utiliza cifrado TLS\n\u2022 Las contrase\xf1as se cifran con bcrypt\n\u2022 Los tokens JWT se utilizan para la autenticaci\xf3n con expiraci\xf3n autom\xe1tica\n\u2022 Los datos de ubicaci\xf3n se retienen durante 7 d\xedas y luego se eliminan autom\xe1ticamente\n\u2022 Se realizan auditor\xedas de seguridad y pruebas de penetraci\xf3n peri\xf3dicas",s5Title:"5. Compartici\xf3n de datos",s5Body:"No vendemos sus datos personales a terceros. Los datos pueden compartirse con:\n\n\u2022 Su administrador de empresa: Los gestores de flota pueden ver los datos de veh\xedculos y conductores dentro de su organizaci\xf3n\n\u2022 Google Maps API: Para el c\xe1lculo de rutas y visualizaci\xf3n de mapas (anonimizado)\n\u2022 Firebase: Para el env\xedo de notificaciones push\n\u2022 Requisitos legales: Cuando lo requiera la ley o los procedimientos legales",s6Title:"6. Sus derechos (RGPD)",s6Body:"Bajo el RGPD, usted tiene derecho a:\n\n\u2022 Acceso: Solicitar una copia de sus datos personales\n\u2022 Rectificaci\xf3n: Corregir datos personales inexactos\n\u2022 Supresi\xf3n: Solicitar la eliminaci\xf3n de sus datos personales\n\u2022 Portabilidad: Recibir sus datos en un formato estructurado y legible por m\xe1quina\n\u2022 Limitaci\xf3n: Restringir el procesamiento de sus datos\n\u2022 Oposici\xf3n: Oponerse al procesamiento de datos basado en intereses leg\xedtimos\n\nPara ejercer estos derechos, cont\xe1ctenos en: destek@tulipfleet.com",s7Title:"7. Contacto",s7Body:"TulipFleet\nCorreo electr\xf3nico: destek@tulipfleet.com\nSitio web: https://tulipfleet.com\n\n\xa9 2025-2026 TulipFleet. Todos los derechos reservados."},adminDrivers:{filterAll:"Todos",filterAvailable:"Disponible",filterOnTask:"En tarea",filterOffline:"Sin conexi\xf3n",vehicle:"Veh\xedculo",tasks:"Tareas",score:"Puntuaci\xf3n",assignedVehicle:"Veh\xedculo asignado",license:"Licencia",phone:"Tel\xe9fono",emergency:"Emergencia",totalKm:"KM total",unnamed:"Sin nombre",noDrivers:"Sin conductores",noDriversDesc:"No se encontraron conductores",loading:"Cargando conductores...",loadError:"Error al cargar",deleteDriver:"Eliminar conductor",deleteConfirm:"\xbfEst\xe1 seguro de que desea eliminar este conductor?",driverDeleted:"Conductor eliminado exitosamente",deleteFailed:"Error al eliminar"},adminVehicles:{filterAll:"Todos",filterAvailable:"Disponible",filterInUse:"En uso",filterOther:"Otro",fuel:"Combustible",offline:"Sin conexi\xf3n",online:"En l\xednea",track:"Rastrear",device:"Dispositivo",color:"Color",category:"Categor\xeda",fuelType:"Tipo de combustible",tankCapacity:"Capacidad del tanque",lastMaint:"\xdaltimo mantenimiento",loading:"Cargando veh\xedculos...",loadError:"Error al cargar veh\xedculos",noVehicles:"Sin veh\xedculos",noVehiclesDesc:"No se encontraron veh\xedculos",deleteVehicle:"Eliminar veh\xedculo",deleteConfirm:"\xbfEst\xe1 seguro de que desea eliminar este veh\xedculo?",vehicleDeleted:"Veh\xedculo eliminado exitosamente",deleteFailed:"Error al eliminar veh\xedculo"},adminTasks:{filterAll:"Todos",filterPending:"Pendiente",filterActive:"Activo",filterCompleted:"Completado",driver:"Conductor",noDriver:"Sin conductor",noDriverAssigned:"Sin conductor asignado",noVehicle:"Sin veh\xedculo",distance:"Distancia",from:"Desde",to:"Hasta",scheduled:"Programado",notes:"Notas",description:"Descripci\xf3n",priorityLabel:"Prioridad",sendOffer:"Enviar oferta",sendOfferConfirm:"\xbfEnviar esta tarea como oferta al conductor?",send:"Enviar",offerSent:"Oferta enviada exitosamente",offerFailed:"Err