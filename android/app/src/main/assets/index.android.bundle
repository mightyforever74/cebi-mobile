llTankNote:"Fill the tank completely",save:"SAVE",calculation:"Calculation Preview",kmTraveled:"Distance Traveled",consumption:"Consumption",costPerKm:"Cost per KM",lastRecord:"Last Record",editVehicle:"Edit Vehicle Info",vehicleUpdated:"Vehicle info updated",plateReadonly:"Plate cannot be changed",firstRecordNote:"This is the first record, consumption will be calculated on the next entry.",loading:"Loading...",noVehicle:"No assigned vehicle",retry:"Retry",validation:{odometerRequired:"Odometer reading is required",odometerMustBeHigher:"Odometer must be higher than previous record ({{lastKm}})",litersRequired:"Liters amount is required",litersExceedsTank:"Maximum {{capacity}}L allowed",consumptionUnrealistic:"Calculated consumption ({{value}} L/100km) seems unrealistic",kmTooHigh:"{{km}} km in a single fill seems too high"},labels:{odometerKm:"Odometer",litersFilled:"Liters Filled",totalCost:"Total Cost (optional)",fullTank:"Full Tank"},hints:{lastRecordTitle:"Last Record",lastRecordPrefix:"\u011f\u0178\u2019\xa1 Last",warningFull:"\xe2\u0161\xa0\xef\xb8\x8f Please fill to FULL"},errors:{vehicleLoadFailed:"Could not load vehicle info",odometerRequired:"Odometer is required",litersRequired:"Liters amount is required",odometerLessThanPrev:"Odometer must be greater than previous ({{prev}})",litersExceedCapacity:"Maximum {{capacity}}L allowed",submitFailed:"Failed to save record"},error:{title:"Error",loadFailed:"Failed to load vehicle info",saveFailed:"Failed to save record",noVehicle:"No vehicle assigned",vehicleUpdateFailed:"Failed to update vehicle info"},confirmNotFull:{title:"Attention",message:"If the tank is not FULL, this entry is excluded from consumption analysis. Continue?",cancel:"Cancel",proceed:"Save Anyway"},notFullTankWarning:{title:"Warning",message:"If the tank is not full, this record won't be included in consumption analysis. Continue anyway?",cancel:"Cancel",saveAnyway:"Save Anyway"},submit:{save:"Save"},success:{title:"Success",message:"Saved!",saved:"Saved",kmTraveled:"{{km}} km",consumptionPer100km:"{{value}} L/100km",costPerKm:"{{value}}/km"},fuelTypes:{diesel:"Diesel",gasoline:"Gasoline",lpg:"LPG",electric:"Electric"}},help:{title:"Help Center",subtitle:"Frequently asked questions and guide",heroTitle:"How can we help you?",heroSubtitle:"Browse frequently asked questions",heroHint:"Tap a category to see questions",quickHelp:"Quick Help",troubleshooting:"Troubleshooting",ledIndicators:"LED Indicators",faqTitle:"Frequently Asked Questions",questionCount:"questions",account:{title:"Account & Login",q1:"How can I change my password?",a1:"Go to Settings > Change Password, enter your current password and set a new one.",q2:"I can't log in to my account, what should I do?",a2:"Check your email address. If you forgot your password, use the 'Forgot Password' option or contact support.",q3:"How do I update my profile information?",a3:"Go to Settings > Edit Profile to update your name, surname and phone number."},vehicles:{title:"Vehicles & Tracking",q1:"How can I see my vehicle's location?",a1:"You can see your vehicle's real-time location on the Dashboard map. Location updates every 5 seconds.",q2:"My vehicle appears offline, what should I do?",a2:"Check the GPS device power connection. Inspect the LED indicators on the device. Verify the internet connection.",q3:"Can I track multiple vehicles at once?",a3:"Yes, you can see all your vehicles on the Live Map screen in the Admin panel."},tasks:{title:"Tasks",q1:"How do I accept a task assigned to me?",a1:"View the incoming task on Dashboard and press 'Accept'. Use 'Start Task' to begin the task.",q2:"How do I mark a task as completed?",a2:"Go to task details and press 'Complete Task'. Fill in the required information and confirm.",q3:"Can I reject an assigned task?",a3:"Yes, view the incoming task and use the 'Reject' option. You will be asked to provide a reason."},technical:{title:"Technical Support",q1:"How do I set up the GPS device?",a1:"Connect the device to the vehicle USB port. Scan the QR code in the mobile app and complete WiFi configuration via BLE.",q2:"The device can't connect to WiFi, what should I do?",a2:"Make sure you're using a 2.4GHz WiFi network (5GHz not supported). Check the password. Restart the device and connect within 60 seconds.",q3:"What do the LED lights mean?",a3:"Solid green: System running. Blinking blue: BLE mode. Yellow: Searching GPS. Red: Error. See LED Indicators page for details."},contact:{title:"Still need help?",subtitle:"If your question is not listed here, contact our support team",button:"Contact Support Team"},footer:"\xa9 2025 TulipFleet - All rights reserved"},troubleshooting:{title:"Troubleshooting",tapToExpand:"Tap to see details",solution:"Solution",stepsToTry:"Steps to Try",stillNeedHelp:"Still need help?",contactUs:"Contact our technical support team",problems:{noPower:"Device won't turn on",noGps:"No GPS signal",noWifi:"WiFi connection error",noBle:"Bluetooth not found",noUpdate:"Location not updating",appCrash:"App crashes"},solutions:{noPower:"Check power connection and fuse.",noGps:"Point GPS antenna to open sky.",noWifi:"Check WiFi password and network settings.",noBle:"Restart device and connect within 60 seconds.",noUpdate:"Check internet connection and server status.",appCrash:"Update app or clear cache."},steps:{checkPowerConnection:"Check power cable connection",checkFuse:"Check vehicle fuse",checkVoltage:"Verify 12V-24V voltage range",moveOutdoors:"Move device outdoors",checkAntenna:"Check GPS antenna connection",avoidMetal:"Move away from metal obstacles",checkPassword:"Make sure WiFi password is correct",use24Ghz:"Use 2.4GHz network (5GHz not supported)",checkSignal:"Check WiFi signal strength",restartDevice:"Restart the device",connect60sec:"Try connecting within 60 seconds",enableBluetooth:"Enable Bluetooth on your phone",checkInternet:"Check your internet connection",checkServer:"Check server status",restartApp:"Restart the application",updateApp:"Update app 