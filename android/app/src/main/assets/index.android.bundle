5\u043c?",heroSubtitle:"\u0420\u0430\u0437\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0447\u0435\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u043d\u0438\u0442\u0435 \u0432\u044a\u043f\u0440\u043e\u0441\u0438",heroHint:"\u0414\u043e\u043a\u043e\u0441\u043d\u0435\u0442\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f, \u0437\u0430 \u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435 \u0432\u044a\u043f\u0440\u043e\u0441\u0438\u0442\u0435",quickHelp:"\u0411\u044a\u0440\u0437\u0430 \u043f\u043e\u043c\u043e\u0449",troubleshooting:"\u041e\u0442\u0441\u0442\u0440\u0430\u043d\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438",ledIndicators:"LED \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438",faqTitle:"\u0427\u0435\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u043d\u0438 \u0432\u044a\u043f\u0440\u043e\u0441\u0438",questionCount:"\u0432\u044a\u043f\u0440\u043e\u0441\u0430",account:{title:"\u0410\u043a\u0430\u0443\u043d\u0442 \u0438 \u0432\u0445\u043e\u0434",q1:"\u041a\u0430\u043a \u0434\u0430 \u0441\u043c\u0435\u043d\u044f \u043f\u0430\u0440\u043e\u043b\u0430\u0442\u0430 \u0441\u0438?",a1:"\u041e\u0442\u0438\u0434\u0435\u0442\u0435 \u0432 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u0421\u043c\u044f\u043d\u0430 \u043d\u0430 \u043f\u0430\u0440\u043e\u043b\u0430, \u0432\u044a\u0432\u0435\u0434\u0435\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0430\u0442\u0430 \u043f\u0430\u0440\u043e\u043b\u0430 \u0438 \u0437\u0430\u0434\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u0430.",q2:"\u041d\u0435 \u043c\u043e\u0433\u0430 \u0434\u0430 \u0432\u043b\u044f\u0437\u0430 \u0432 \u0430\u043a\u0430\u0443\u043d\u0442\u0430 \u0441\u0438, \u043a\u0430\u043a\u0432\u043e \u0434\u0430 \u043f\u0440\u0430\u0432\u044f?",a2:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0438\u043c\u0435\u0439\u043b\u0430 \u0441\u0438. \u0410\u043a\u043e \u0441\u0442\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u0438\u043b\u0438 \u043f\u0430\u0440\u043e\u043b\u0430\u0442\u0430, \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \"\u0417\u0430\u0431\u0440\u0430\u0432\u0435\u043d\u0430 \u043f\u0430\u0440\u043e\u043b\u0430\" \u0438\u043b\u0438 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430.",q3:"\u041a\u0430\u043a \u0434\u0430 \u043e\u0431\u043d\u043e\u0432\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u043d\u0430\u0442\u0430 \u0441\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f?",a3:"\u041e\u0442\u0438\u0434\u0435\u0442\u0435 \u0432 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u0444\u0438\u043b, \u0437\u0430 \u0434\u0430 \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0438\u043c\u0435\u0442\u043e, \u0444\u0430\u043c\u0438\u043b\u0438\u044f\u0442\u0430 \u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0441\u0438."},vehicles:{title:"\u041f\u0440\u0435\u0432\u043e\u0437\u043d\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438 \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430\u043d\u0435",q1:"\u041a\u0430\u043a \u0434\u0430 \u0432\u0438\u0434\u044f \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0430 \u0441\u0438?",a1:"\u041c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u0432 \u0440\u0435\u0430\u043b\u043d\u043e \u0432\u0440\u0435\u043c\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u0430\u0442\u0430 \u0432 \u0422\u0430\u0431\u043b\u043e\u0442\u043e. \u041e\u0431\u043d\u043e\u0432\u044f\u0432\u0430 \u0441\u0435 \u043d\u0430 \u0432\u0441\u0435\u043a\u0438 5 \u0441\u0435\u043a\u0443\u043d\u0434\u0438.",q2:"\u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044a\u0442 \u043c\u0438 \u0438\u0437\u0433\u043b\u0435\u0436\u0434\u0430 \u043e\u0444\u043b\u0430\u0439\u043d, \u043a\u0430\u043a\u0432\u043e \u0434\u0430 \u043f\u0440\u0430\u0432\u044f?",a2:"\u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0437\u0430\u0445\u0440\u0430\u043d\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 GPS \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e. \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 LED \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438\u0442\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0432\u0440\u044a\u0437\u043a\u0430\u0442\u0430.",q3:"\u041c\u043e\u0433\u0430 \u043b\u0438 \u0434\u0430 \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430\u043c \u043d\u044f\u043a\u043e\u043b\u043a\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0430 \u0435\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e?",a3:"\u0414\u0430, \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435 \u0432\u0441\u0438\u0447\u043a\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0438 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0430 \"\u0416\u0438\u0432\u0430 \u043a\u0430\u0440\u0442\u0430\" \u0432 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u044f \u043f\u0430\u043d\u0435\u043b."},tasks:{title:"\u0417\u0430\u0434\u0430\u0447\u0438",q1:"\u041a\u0430\u043a \u0434\u0430 \u043f\u0440\u0438\u0435\u043c\u0430 \u0437\u0430\u0434\u0430\u0447\u0430, \u043a\u043e\u044f\u0442\u043e \u043c\u0438 \u0435 \u0440\u0430\u0437\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0430?",a1:"\u0420\u0430\u0437\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0432\u0445\u043e\u0434\u044f\u0449\u0430\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0432 \u0422\u0430\u0431\u043b\u043e\u0442\u043e \u0438 \u043d\u0430\u0442\u0438\u0441\u043d\u0435\u0442\u0435 \"\u041f\u0440\u0438\u0435\u043c\u0438\". \u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \"\u0417\u0430\u043f\u043e\u0447\u043d\u0438\", \u0437\u0430 \u0434\u0430 \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0442\u0435.",q2:"\u041a\u0430\u043a \u0434\u0430 \u043e\u0442\u0431\u0435\u043b\u0435\u0436\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u043a\u0430\u0442\u043e \u0437\u0430\u0432\u044a\u0440\u0448\u0435\u043d\u0430?",a2:"\u0412\u043b\u0435\u0437\u0442\u0435 \u0432 \u0434\u0435\u0442\u0430\u0439\u043b\u0438\u0442\u0435 \u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430 \u0438 \u043d\u0430\u0442\u0438\u0441\u043d\u0435\u0442\u0435 \"\u0417\u0430\u0432\u044a\u0440\u0448\u0438\". \u041f\u043e\u043f\u044a\u043b\u043d\u0435\u0442\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430\u0442\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f.",q3:"\u041c\u043e\u0433\u0430 \u043b\u0438 \u0434\u0430 \u043e\u0442\u0445\u0432\u044a\u0440\u043b\u044f \u0440\u0430\u0437\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0430?",a3:"\u0414\u0430, \u0440\u0430\u0437\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430 \u0438 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u043e\u043f\u0446\u0438\u044f\u0442\u0430 \"\u041e\u0442\u0445\u0432\u044a\u0440\u043b\u0438\". \u0429\u0435 \u0431\u044a\u0434\u0435 \u043f\u043e\u0438\u0441\u043a\u0430\u043d\u0430 \u043f\u0440\u0438\u0447\u0438\u043d\u0430."},technical:{title:"\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430",q1:"\u041a\u0430\u043a \u0434\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u044f GPS \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e?",a1:"\u0421\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e \u043a\u044a\u043c USB \u043f\u043e\u0440\u0442\u0430 \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0430. \u0421\u043a\u0430\u043d\u0438\u0440\u0430\u0439\u0442\u0435 QR \u043a\u043e\u0434\u0430 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u0442\u043e \u0438 \u0437\u0430\u0432\u044a\u0440\u0448\u0435\u0442\u0435 WiFi \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f\u0442\u0430 \u0447\u0440\u0435\u0437 BLE.",q2:"\u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435 \u0441 WiFi, \u043a\u0430\u043a\u0432\u043e \u0434\u0430 \u043f\u0440\u0430\u0432\u044f?",a2:"\u0423\u0432\u0435\u0440\u0435\u0442\u0435 \u0441\u0435, \u0447\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442\u0435 2.4GHz WiFi \u043c\u0440\u0435\u0436\u0430 (5GHz \u043d\u0435 \u0441\u0435 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430). \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u0442\u0435 \u043f\u0430\u0440\u043e\u043b\u0430\u0442\u0430. \u0420\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0439\u0442\u0435 \u0438 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0432 \u0440\u0430\u043c\u043a\u0438\u0442\u0435 \u043d\u0430 60 \u0441\u0435\u043a\u0443\u043d\u0434\u0438.",q3:"\u041a\u0430\u043a\u0432\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430\u0442 LED \u0441\u0432\u0435\u0442\u043b\u0438\u043d\u0438\u0442\u0435?",a3:"\u0417\u0435\u043b\u0435\u043d: \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0438. \u041c\u0438\u0433\u0430\u0449 \u0441\u0438\u043d: BLE \u0440\u0435\u0436\u0438\u043c. \u0416\u044a\u043b\u0442: \u0442\u044a\u0440\u0441\u0438 GPS. \u0427\u0435\u0440\u0432\u0435\u043d: \u0433\u0440\u0435\u0448\u043a\u0430. \u0412\u0438\u0436\u0442\u0435 LED \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438\u0442\u0435 \u0437\u0430 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438."},contact:{title:"\u0412\u0441\u0435 \u043e\u0449\u0435 \u0438\u043c\u0430\u0442\u0435 \u043d\u0443\u0436\u0434\u0430 \u043e\u0442 \u043f\u043e\u043c\u043e\u0449?",subtitle:"\u0410\u043a\u043e \u0432\u044a\u043f\u0440\u043e\u0441\u044a\u0442 \u0432\u0438 \u043d\u0435 \u0435 \u0442\u0443\u043a, \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441\u0435 \u0441 \u0435\u043a\u0438\u043f\u0430 \u043d\u0438 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430",button:"\u0421\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441\u0435 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430"},footer:"\xa9 2025 TulipFleet - \u0412\u0441\u0438\u0447\u043a\u0438 \u043f\u0440\u0430\u0432\u0430 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438"},troubleshooting:{title:"\u041e\u0442\u0441\u0442\u0440\u0430\u043d\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0435\u0438\u0437\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438",tapToExpand:"\u0414\u043e\u043a\u043e\u0441\u043d\u0435\u0442\u0435 \u0437\u0430 \u0434\u0435\u0442\u0430\u0439\u043b\u0438",solution:"\u0420\u0435\u0448\u0435\u043d\u0438\u0435",stepsToTry:"\u0421\u0442\u044a\u043f\u043a\u0438 \u0437\u0430 \u043e\u043f\u0438\u0442",stillNeedHelp:"\u0412\u0441\u0435 \u043e\u0449\u0435 \u0441\u0435 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0435 \u043e\u0442 \u043f\u043e\u043c\u043e\u0449?",contactUs:"\u0421\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441\u0435 \u0441 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430",problems:{noPower:"\u0423\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0435 \u0441\u0435 \u0432\u043a\u043b\u044e\u0447\u0432\u0430",noGps:"\u041d\u044f\u043c\u0430 GPS \u0441\u0438\u0433\u043d\u043