{
  "expo": {
    "name": "TulipFleet",
    "slug": "tulipfleet",
    "platforms": ["ios", "android"],
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#5E72E4"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tulipfleet.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Cihazları bulmak ve bağlanmak için Bluetooth izni gerekli",
        "NSBluetoothPeripheralUsageDescription": "Cihazlara bağlanmak için Bluetooth izni gerekli",
        "NSCameraUsageDescription": "QR kod okumak için kamera izni gerekli",
        "NSLocationWhenInUseUsageDescription": "Bluetooth cihazlarını bulmak için konum izni gerekli"
      }
    },
    "android": {
      "package": "com.tulipfleet.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Cihaz QR kodunu okumak için kamera izni gerekli"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Cihazları bulmak ve bağlanmak için Bluetooth izni gerekli"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5E72E4"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "40f17d93-c362-4f31-90b1-ba6bc7b3ef0d"
      }
    },
    "owner": "mightyforever"
  }
}
