{
  "expo": {
    "name": "TulipFleet",
    "slug": "tulipfleet",
    "platforms": ["ios", "android"],
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#5E72E4"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/7c0ea9e5-7cc1-4723-ad38-3fbe23256d50"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tulipfleet.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCF0dHTuw9SJULB56eiimUt3RJIRnph3gk"
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Cihaz kurulumu için Bluetooth gereklidir",
        "NSBluetoothPeripheralUsageDescription": "ESP32 cihazıyla iletişim için Bluetooth gereklidir",
        "NSCameraUsageDescription": "QR kod okumak için kamera izni gerekli",
        "NSLocationWhenInUseUsageDescription": "Bluetooth cihazlarını bulmak için konum izni gerekli",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tulipfleet.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCF0dHTuw9SJULB56eiimUt3RJIRnph3gk"
        }
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Cihaz QR kodunu okumak için kamera izni gerekli"
        }
      ],
      "react-native-ble-plx",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5E72E4"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "ccacheEnabled": false
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "./plugins/withFirebaseFix",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist"
          }
        }
      ]
    ],
    "owner": "mightyforever",
    "extra": {
      "eas": {
        "projectId": "7c0ea9e5-7cc1-4723-ad38-3fbe23256d50"
      }
    }
  }
}
