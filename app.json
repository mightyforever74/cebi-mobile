{
  "expo": {
    "name": "TulipFleet Cebi",
    "slug": "cebi-mobile",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": "2.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tulipfleet.cebi",
      "buildNumber": "30",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCZ8c143eugWAgg08XaCAXa-aJa5YLTDSA"
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Cihaz kurulumu için Bluetooth gereklidir",
        "NSBluetoothPeripheralUsageDescription": "ESP32 cihazıyla iletişim için Bluetooth gereklidir",
        "NSCameraUsageDescription": "QR kod okumak için kamera izni gerekli",
        "NSLocationWhenInUseUsageDescription": "Bluetooth cihazlarını bulmak için konum izni gerekli",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tulipfleet.cebi",
      "versionCode": 28,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyArByYajxwW3sbYamRU4QTy2nValdDxcmM"
        }
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Cihaz QR kodunu okumak için kamera izni gerekli"
        }
      ],
      "react-native-ble-plx",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TulipFleet, sefer devam ederken konumunuzu uygulama arka plandayken de paylaşabilmek için 'Her Zaman' konum izni ister.",
          "locationAlwaysPermission": "TulipFleet, sefer devam ederken konumunuzu uygulama arka plandayken de paylaşabilmek için 'Her Zaman' konum izni ister.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5E72E4"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "ccacheEnabled": false
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-bootsplash",
        {
          "assetsDir": "assets/bootsplash",
          "android": {
            "parentTheme": "TransparentStatus",
            "darkContentBarsStyle": false
          }
        }
      ]
    ],
    "owner": "mightyforever",
    "extra": {
      "eas": {
        "projectId": "14378253-7bd3-451e-98bc-3ee3b59376a5"
      }
    }
  }
}
