{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cebi-api.tulipfleet.com",
        "MQTT_HOST": "cebi-api.tulipfleet.com"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.tulipfleet.com",
        "MQTT_HOST": "staging-mqtt.tulipfleet.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "staging",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cebi-api.tulipfleet.com",
        "MQTT_HOST": "cebi-api.tulipfleet.com"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "node": "20.19.4",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cebi-api.tulipfleet.com",
        "MQTT_HOST": "cebi-api.tulipfleet.com",
        "MQTT_PORT": "8883",
        "MQTT_USERNAME": "fleet-backend",
        "MQTT_USE_SSL": "true"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./pc-api-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "cem.sahinkaya6@icloud.com",
        "ascAppId": "6757311314"
      }
    }
  }
}
