{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "http://46.224.1.192:3000",
        "MQTT_HOST": "46.224.1.192"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://staging-api.tulipfleet.com",
        "MQTT_HOST": "staging-mqtt.tulipfleet.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "staging"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://api.tulipfleet.com",
        "MQTT_HOST": "mqtt.tulipfleet.com"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "env": {
        "API_URL": "https://api.tulipfleet.com",
        "MQTT_HOST": "mqtt.tulipfleet.com",
        "GOOGLE_SERVICES_PLIST": "@eas/GOOGLE_SERVICES_PLIST"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./pc-api-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "cem.sahinkaya6@icloud.com",
        "ascAppId": "6757311314"
      }
    }
  }
}
