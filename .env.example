# ═══════════════════════════════════════════════════════════════════
# TulipFleet Mobile App - Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────────────────────────────

# Production
# API_URL=https://api.tulipfleet.com

# Staging
# API_URL=https://staging-api.tulipfleet.com

# Development (direct IP)
API_URL=http://46.224.1.192:3000
API_TIMEOUT=30000

# ─────────────────────────────────────────────────────────────────────
# MQTT Configuration (WebSocket over TLS)
# ─────────────────────────────────────────────────────────────────────

# Production
# MQTT_HOST=mqtt.tulipfleet.com

# Development
MQTT_HOST=46.224.1.192
MQTT_PORT=8883
MQTT_USERNAME=fleet-backend
MQTT_PASSWORD=BackendMQTT2024!

# WebSocket Configuration
WS_URL=wss://46.224.1.192:3000

# App Configuration
APP_ENV=development
DEBUG_MODE=true

# ─────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────

ENABLE_BLE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CRASH_REPORTING=false

# ─────────────────────────────────────────────────────────────────────
# EAS Build Secrets (set in eas.json or EAS Dashboard)
# ─────────────────────────────────────────────────────────────────────
# These should NOT be in .env file, use EAS Secrets instead:
# - GOOGLE_MAPS_API_KEY
# - SENTRY_DSN
# - EXPO_PUBLIC_* variables

# ─────────────────────────────────────────────────────────────────────
# Store Publishing (placeholders committed to repo)
# ─────────────────────────────────────────────────────────────────────

# Apple
ASC_ISSUER_ID=
ASC_KEY_ID=ZM69S6D4SK
ASC_PRIVATE_KEY_P8_BASE64=
APPLE_TEAM_ID=99VQJFW336
IOS_BUNDLE_ID=com.tulipfleet.app

# Google Play
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
ANDROID_PACKAGE_NAME=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=