# API Configuration
API_URL=https://your-vps-ip:3000
API_TIMEOUT=30000

# MQTT Configuration
MQTT_HOST=your-vps-ip
MQTT_PORT=8883
MQTT_USE_SSL=true
MQTT_CLIENT_ID=fleet360_mobile
MQTT_USERNAME=fleet_client
MQTT_PASSWORD=your_mqtt_password

# WebSocket Configuration
WS_URL=wss://your-vps-ip:3000

# App Configuration
APP_ENV=development
DEBUG_MODE=true

# Feature Flags
ENABLE_BLE=true
ENABLE_PUSH_NOTIFICATIONS=false